rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hard security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserVerified() {
      return isSignedIn();
    }

    // Auth tokens never contain trusted role/company data in Standard SDKs. We look up on DB:
    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSameCompany(companyId) {
      return isSignedIn() && (
        (request.auth.token.company_id == companyId) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userCompanyId() == companyId)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.role == 'SUPER_ADMIN') ||
        (request.auth.token.role == 'MAIN_CONTRACTOR_ADMIN') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          userRole() == 'SUPER_ADMIN' || userRole() == 'MAIN_CONTRACTOR_ADMIN'
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Helpers ---

    function isValidCompany(data) {
      return data.keys().hasAll(['id', 'name', 'taxId', 'type', 'inviteCode', 'active']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.taxId is string && data.taxId.size() >= 5 && data.taxId.size() <= 20 &&
        (data.type == 'MAIN_CONTRACTOR' || data.type == 'SUBCONTRACTOR') &&
        data.inviteCode is string && data.inviteCode.size() <= 30 &&
        data.active is bool;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'active']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 120 &&
        (data.role == 'SUPER_ADMIN' || data.role == 'MAIN_CONTRACTOR_ADMIN' || data.role == 'SITE_MANAGER' || data.role == 'SUBCONTRACTOR_USER') &&
        data.active is bool &&
        (data.get('companyId', '') is string) &&
        (data.get('companyName', '') is string) &&
        (data.get('createdAt', '') is string) &&
        (data.get('assignedProjectIds', []) is list);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'status', 'companyId', 'validationRadiusMeters']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 30 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 150 &&
        (data.status == 'Planned' || data.status == 'Active' || data.status == 'Paused' || data.status == 'Completed' || data.status == 'Archived') &&
        data.companyId is string && data.companyId.size() <= 128 &&
        data.validationRadiusMeters is number && data.validationRadiusMeters >= 10 &&
        (data.get('address', '') is string) &&
        (data.get('latitude', 0.0) is number) &&
        (data.get('longitude', 0.0) is number);
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'category', 'companyId', 'active']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 30 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 80 &&
        data.companyId is string && data.companyId.size() <= 128 &&
        data.active is bool;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['id', 'code', 'companyId', 'projectId', 'date', 'creatorId', 'status', 'version']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 40 &&
        data.companyId is string && data.companyId.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 20 &&
        data.creatorId is string && data.creatorId.size() <= 128 &&
        (data.status == 'Draft' || data.status == 'Submitted' || data.status == 'Corrected' || data.status == 'Locked' || data.status == 'Cancelled') &&
        data.version is number && data.version >= 1;
    }

    function isValidDeliveryNote(data) {
      return data.keys().hasAll(['id', 'code', 'companyId', 'sourceDailyReportId', 'projectId', 'subcontractorCompanyId', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 40 &&
        data.companyId is string && data.companyId.size() <= 128 &&
        data.sourceDailyReportId is string && data.sourceDailyReportId.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.subcontractorCompanyId is string && data.subcontractorCompanyId.size() <= 128 &&
        (data.status == 'Pending' || data.status == 'Confirmed' || data.status == 'Disputed');
    }

    function isValidAuditEvent(data) {
      return data.keys().hasAll(['id', 'timestamp', 'actorId', 'actorName', 'affectedEntity', 'recordId', 'operation']) &&
        data.id is string && data.id.size() <= 128 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        data.actorId is string && data.actorId.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 100 &&
        data.affectedEntity is string && data.affectedEntity.size() <= 50 &&
        data.recordId is string && data.recordId.size() <= 128 &&
        data.operation is string && data.operation.size() <= 50;
    }

    // --- Collections ---

    // 1. Companies (Isolated by companyId)
    match /companies/{companyId} {
      allow get: if isUserVerified() && isValidId(companyId) && (isAdmin() || isSameCompany(companyId));
      allow list: if isUserVerified() && (resource.data.id == userCompanyId() || request.auth.token.company_id == resource.data.id || isAdmin());
      allow create: if isUserVerified() && isValidId(companyId) && isValidCompany(incoming()) && isAdmin();
      allow update: if isUserVerified() && isValidId(companyId) && isValidCompany(incoming()) && (
        isAdmin() ||
        (isSameCompany(companyId) && incoming().id == existing().id && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'inviteCode', 'active']))
      );
      allow delete: if isAdmin() && isValidId(companyId);
    }

    // 2. Users (Role escalations, Company tampering, self-privilege locked)
    match /users/{userId} {
      allow get: if isUserVerified() && isValidId(userId) && (isAdmin() || isOwner(userId) || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || resource.data.id == request.auth.uid || isAdmin());
      allow create: if isUserVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (isOwner(userId) && incoming().role == 'SUBCONTRACTOR_USER' && incoming().isSuperAdmin != true)
      );
      allow update: if isUserVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().companyId == existing().companyId &&
          incoming().get('isSuperAdmin', false) == existing().get('isSuperAdmin', false) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name'])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Projects (Multi-tenant isolated by companyId)
    match /projects/{projectId} {
      allow get: if isUserVerified() && isValidId(projectId) && (isAdmin() || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() || isSameCompany(incoming().companyId)
      );
      allow update: if isUserVerified() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() || (
          isSameCompany(existing().companyId) && 
          incoming().companyId == existing().companyId && 
          incoming().id == existing().id &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'location', 'validationRadiusMeters', 'plannedHours', 'startDate', 'endDate', 'assignedUserIds', 'address', 'latitude', 'longitude', 'client', 'initialBudget', 'spentBudget', 'coverImage', 'projectType', 'description', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // 4. Workers (Isolated by companyId)
    match /workers/{workerId} {
      allow get: if isUserVerified() && isValidId(workerId) && (isAdmin() || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(workerId) && isValidWorker(incoming()) && (
        isAdmin() || isSameCompany(incoming().companyId)
      );
      allow update: if isUserVerified() && isValidId(workerId) && isValidWorker(incoming()) && (
        isAdmin() || (
          isSameCompany(existing().companyId) && 
          incoming().companyId == existing().companyId && 
          incoming().id == existing().id &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'active', 'nationalId'])
        )
      );
      allow delete: if isAdmin() && isValidId(workerId);
    }

    // 5. Daily Reports (Isolated by companyId, creatorId is immutable)
    match /dailyReports/{reportId} {
      allow get: if isUserVerified() && isValidId(reportId) && (
        isAdmin() || isSameCompany(existing().companyId)
      );
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(reportId) && isValidDailyReport(incoming()) && (
        isAdmin() || (
          isSameCompany(incoming().companyId) &&
          incoming().creatorId == request.auth.uid
        )
      );
      allow update: if isUserVerified() && isValidId(reportId) && isValidDailyReport(incoming()) && (
        isAdmin() || (
          isSameCompany(existing().companyId) &&
          incoming().companyId == existing().companyId &&
          incoming().id == existing().id &&
          incoming().creatorId == existing().creatorId &&
          (existing().status == 'Draft' || existing().status == 'Submitted') &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'workEntries', 'totalNormalHours', 'totalExtraHours', 'totalHours', 
            'comments', 'siteConditions', 'evidenceUrls', 'locationSnapshot', 'analysisItems', 
            'correctionReason', 'originalReportId', 'version', 'updatedAt', 'submittedAt'
          ])
        )
      );
      allow delete: if isAdmin() && isValidId(reportId);
    }

    // 6. Delivery Notes (Isolated for both Subcontractor and Main Contractor)
    match /deliveryNotes/{deliveryNoteId} {
      allow get: if isUserVerified() && isValidId(deliveryNoteId) && (
        isAdmin() ||
        isSameCompany(existing().companyId) ||
        isSameCompany(existing().subcontractorCompanyId)
      );
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || resource.data.subcontractorCompanyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(deliveryNoteId) && isValidDeliveryNote(incoming()) && (
        isAdmin() || isSameCompany(incoming().companyId)
      );
      allow update: if isUserVerified() && isValidId(deliveryNoteId) && isValidDeliveryNote(incoming()) && (
        isAdmin() ||
        (isSameCompany(existing().companyId) &&
          incoming().companyId == existing().companyId &&
          incoming().id == existing().id &&
          existing().status == 'Pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'confirmationDetails', 'confirmedBy', 'disputeRecord', 'dispute', 'correctionNotice', 'updatedAt'
          ])
        ) ||
        (isSameCompany(existing().subcontractorCompanyId) &&
          incoming().subcontractorCompanyId == existing().subcontractorCompanyId &&
          incoming().id == existing().id &&
          existing().status == 'Pending' &&
          (incoming().status == 'Confirmed' || incoming().status == 'Disputed') &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'confirmationDetails', 'confirmedBy', 'disputeRecord', 'dispute', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin() && isValidId(deliveryNoteId);
    }

    // 7. Audit Events (Append-Only Log, Actor ID is immutable)
    match /auditEvents/{auditEventId} {
      allow get: if isUserVerified() && isValidId(auditEventId) && (
        isAdmin() || existing().actorId == request.auth.uid
      );
      allow list: if isUserVerified() && (resource.data.actorId == request.auth.uid || isAdmin());
      allow create: if isUserVerified() && isValidId(auditEventId) && isValidAuditEvent(incoming()) && (
        isAdmin() || incoming().actorId == request.auth.uid
      );
      // Append-only constraint: updates and deletes are strictly denied
      allow update, delete: if false;
    }

    // 8. Time Logs (Field Check-ins, isolated by userId/companyId)
    match /time_logs/{timeLogId} {
      allow get: if isUserVerified() && isValidId(timeLogId) && (isAdmin() || existing().userId == request.auth.uid || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.userId == request.auth.uid || resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(timeLogId) && (
        isAdmin() || (incoming().userId == request.auth.uid && incoming().companyId == userCompanyId())
      );
      allow update: if isUserVerified() && isValidId(timeLogId) && (
        isAdmin() || (incoming().userId == request.auth.uid && incoming().companyId == userCompanyId() && incoming().id == existing().id)
      );
      allow delete: if isAdmin() && isValidId(timeLogId);
    }

    // 9. Invitations (Isolated by companyId)
    match /invitations/{invitationId} {
      allow get: if isUserVerified() && isValidId(invitationId) && (isAdmin() || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(invitationId) && (isAdmin() || isSameCompany(incoming().companyId));
      allow update: if isUserVerified() && isValidId(invitationId) && (isAdmin() || isSameCompany(incoming().companyId));
      allow delete: if isAdmin() && isValidId(invitationId);
    }

    // 10. Compliance Documents (Isolated by companyId)
    match /complianceDocuments/{documentId} {
      allow get: if isUserVerified() && isValidId(documentId) && (isAdmin() || isSameCompany(existing().companyId));
      allow list: if isUserVerified() && (resource.data.companyId == userCompanyId() || isAdmin());
      allow create: if isUserVerified() && isValidId(documentId) && (isAdmin() || isSameCompany(incoming().companyId));
      allow update: if isUserVerified() && isValidId(documentId) && (isAdmin() || (isSameCompany(existing().companyId) && incoming().companyId == existing().companyId && incoming().id == existing().id));
      allow delete: if isAdmin() && isValidId(documentId);
    }

    // 11. Connection Test Probe
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
